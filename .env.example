# --- Model per agent role: "provider:model" -------------------------------
# Providers: groq | anthropic | google_genai | ollama
# Roles without an override use CODEPILOT_MODEL_DEFAULT (free Groq if unset).
CODEPILOT_MODEL_DEFAULT=groq:openai/gpt-oss-120b
CODEPILOT_MODEL_CLASSIFIER=groq:openai/gpt-oss-20b
CODEPILOT_MODEL_SUMMARIZER=groq:openai/gpt-oss-20b
# CODEPILOT_MODEL_CODER=anthropic:claude-sonnet-5
# CODEPILOT_MODEL_TESTER=anthropic:claude-sonnet-5

# --- Provider keys (only the ones your roles use) --------------------------
GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
ANTHROPIC_API_KEY=       # https://console.anthropic.com (pay as you go)
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey (free tier)

# --- GitHub App (target repository) -----------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=  # path to the .pem file, or the key contents
GITHUB_REPOSITORY=       # owner/repo, e.g. sreedhardt/rate-limiter

# --- Observability (optional) -----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codepilot-agent
