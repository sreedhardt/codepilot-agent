# --- Model per agent role: "provider:model" -------------------------------
# Providers: groq | anthropic | google_genai | ollama
# Roles without an override use CODEPILOT_MODEL_DEFAULT. Agent loops need more than
# Groq free tier allows (8k tokens/min; one DeepAgents call is ~that size), so the
# default is Haiku; single-call roles (classifier, summarizer, input rail) stay on free Groq.
CODEPILOT_MODEL_DEFAULT=anthropic:claude-haiku-4-5
CODEPILOT_MODEL_CLASSIFIER=groq:openai/gpt-oss-120b
CODEPILOT_MODEL_SUMMARIZER=groq:openai/gpt-oss-20b
CODEPILOT_MODEL_CODER=anthropic:claude-sonnet-5
CODEPILOT_MODEL_TESTER=anthropic:claude-sonnet-5
# The reviewer gates every PR; keep it a different model from the coder.
CODEPILOT_MODEL_REVIEWER=anthropic:claude-haiku-4-5
# NeMo Guardrails input rail that screens issue text before triage.
CODEPILOT_MODEL_INPUT_RAIL=groq:openai/gpt-oss-20b

# --- Provider keys (only the ones your roles use) --------------------------
GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
ANTHROPIC_API_KEY=       # https://console.anthropic.com (pay as you go)
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey (free tier)

# --- GitHub App (target repository) -----------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=  # path to the .pem file, or the key contents
GITHUB_REPOSITORY=       # owner/repo, e.g. sreedhardt/bookshelf-api

# --- Observability (optional) -----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codepilot-agent

# --- Target repository on disk ------------------------------------------------
# A local clone of GITHUB_REPOSITORY; each task works on a disposable copy of it.
CODEPILOT_TARGET_PATH=../bookshelf-api
# Host test mode only: the target's virtualenv bin directory (default: <target>/.venv/bin).
# CODEPILOT_TARGET_PYTHON_BIN=

# --- Safety -----------------------------------------------------------------
CODEPILOT_TEST_SANDBOX=auto     # auto | docker | host: where agent-written tests run
CODEPILOT_INPUT_RAIL=on         # off disables the NeMo input rail
CODEPILOT_MAX_TASK_COST_USD=2.0
CODEPILOT_MAX_TASK_MINUTES=20

# --- Intake -----------------------------------------------------------------
CODEPILOT_POLL_MINUTES=5
CODEPILOT_ISSUE_LABEL=ai-assignable
CODEPILOT_TAKE_UNLABELLED=true            # also take unassigned issues without the label
CODEPILOT_MAX_COMPLEXITY=8                # 1-10, labelled issues and TUI tasks
CODEPILOT_MAX_UNLABELLED_COMPLEXITY=4     # 1-10, unlabelled issues (never commented on)
CODEPILOT_MIN_CONFIDENCE=0.6
CODEPILOT_RETRY_FAILED_AFTER_HOURS=24

# --- Memory -----------------------------------------------------------------
CODEPILOT_USE_DRAFT_LESSONS=false         # true: also use lessons from PRs not merged yet (demos)
